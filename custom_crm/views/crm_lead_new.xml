<odoo>
    <record id="view_crm_lead_form_customer_category" model="ir.ui.view">
        <field name="name">crm.lead.form.customer.category</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']"
                   position="after">
                <field name="customer_category"/>
            </xpath>

        </field>
    </record>
</odoo>