<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_move_form_add_copy_button" model="ir.ui.view">
        <field name="name">account.move.form.add.copy.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                <button
                    name="action_copy_move_line"
                    type="object"
                    string="Copy"
                    class="btn-secondary"
                    icon="fa-copy"
                />
            </xpath>
        </field>
    </record>
</odoo>