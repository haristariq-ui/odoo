<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_salary_timesheet_wizard_form" model="ir.ui.view">
        <field name="name">salary.timesheet.wizard.form</field>
        <field name="model">salary.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Timesheet">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button
                        name="action_generate_report"
                        string="Generate"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_salary_timesheet_wizard" model="ir.actions.act_window">
        <field name="name">Salary Timesheet</field>
        <field name="res_model">salary.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>