<odoo>

    <record id="product_template_form_inherit_equipment" model="ir.ui.view">
        <field name="name">product.template.form.inherit.equipment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']"
                   position="after">
                <field name="is_equipment"/>
            </xpath>
        </field>
    </record>
</odoo>