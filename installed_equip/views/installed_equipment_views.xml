<odoo>
    <!-- List View -->
   <record id="installed_equipment_list" model="ir.ui.view">
        <field name="name">installed.equipment.list</field>
        <field name="model">installed.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="customer_id"/>
                <field name="sale_order_id"/>
                <field name="delivery_order_id"/>
                <field name="installation_date"/>
                <field name="delivery_date"/>
            </list>
        </field>
   </record>
    <!-- Form View -->
    <record id="installed_equipment_form"
            model="ir.ui.view">
        <field name="name">installed.equipment.form</field>
        <field name="model">installed.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="lot_id"/>
                        <field name="rec_d_into_inventory"/>
                        <field name="sale_order_id"/>
                        <field name="delivery_order_id"/>
                        <field name="customer_id"/>
                        <field name="installation_date"/>
                        <field name="delivery_date"/>
                        <field name="installed_at_current_location"/>
                        <field name="stock_move_line_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
        <!-- TEMPORARY-->

    <record id="action_installed_equipment_test" model="ir.actions.act_window">
        <field name="name">Installed Equipments Test</field>
        <field name="res_model">installed.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_installed_equipment_test"
        name="Installed Equipments Test"
        parent="stock.menu_stock_root"
        action="action_installed_equipment_test"
        sequence="99"/>

</odoo>