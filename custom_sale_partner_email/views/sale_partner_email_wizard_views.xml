<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sale_partner_email_wizard_form" model="ir.ui.view">
        <field name="name">sale.partner.email.wizard.form</field>
        <field name="model">sale.partner.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Sale Order">
                <group>
                    <field name="sale_order_id"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>