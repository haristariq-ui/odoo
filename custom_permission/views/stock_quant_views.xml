<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inherit_inventory_permission" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.permission</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="before">
                <field name="can_edit_inventoried_qty" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="attributes">
                <attribute name="readonly">not can_edit_inventoried_qty</attribute>
            </xpath>
        </field>
    </record>
</odoo>