<odoo>
    <record id="sale_order_form_vendor_button_v2" model="ir.ui.view">
        <field name="name">sale.order.form.vendor.v2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                   position="after">
                <button name="action_open_vendor_wizard"
                        type="object"
                        string="Vendor Data"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="before">
                <field name="custom_vendor_id"/>
            </xpath>
        </field>
    </record>
</odoo>