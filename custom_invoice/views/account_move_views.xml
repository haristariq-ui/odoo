<odoo>
    <record id="view_move_form_inherit_previous_current_balance" model="ir.ui.view">
        <field name="name">account.move.form.previous.current.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_residual']" position="before">
                <field name="previous_balance" readonly="1"/>
                <field name="current_balance" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>