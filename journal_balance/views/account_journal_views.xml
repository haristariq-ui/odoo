<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_account_journal_dashboard_kanban_inherit" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
<!--             <xpath expr="//t[@t-name='card']//t[@t-name='JournalBodyBankCash']//div[@id='dashboard_bank_cash_balance']/span"-->
<!--                   position="replace">-->
<!--                <span>Unreconciled Balance</span>-->
<!--            </xpath>-->

<!--             <xpath expr="//t[@t-name='JournalBodyBankCash']//span[text()='Balance']" position="replace">-->
<!--                <span>Unreconciled Balance</span>-->
<!--            </xpath>-->

<!--              <xpath expr="//span[text()='Balance']" position="replace">-->
<!--                <span>Unreconciled Balance</span>-->
<!--            </xpath>-->
             <xpath expr="//div[@id='dashboard_bank_cash_balance']" position="replace">
                <div id="dashboard_bank_cash_balance" class="col overflow-hidden text-start">
                    <span>Unreconcile Balance</span>
                </div>
            </xpath>
             <xpath expr="//kanban/field[@name='kanban_dashboard']" position="after">
                <field name="balance"/>
            </xpath>

            <xpath expr="//div[@id='dashboard_bank_cash_misc_total']/parent::div" position="after">
                <div class="row">
                    <div class="col text-start">
                        <span>Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr">
                           $ <t t-out="record.balance.value"/>
                        </span>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>