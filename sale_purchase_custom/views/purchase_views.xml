<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_custom" model="ir.ui.view">

        <field name="name">purchase.order.form.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='dest_address_id']" position="after">
                <field name="vendor_reference_no"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="before">
               <field name="slab_weight"/>

           </xpath>

        </field>

    </record>

</odoo>