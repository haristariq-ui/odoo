<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="invoice_form_custom" model="ir.ui.view">

        <field name="name">account.move.form.custom</field>

        <field name="model">account.move</field>

        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//div[field[@name='partner_id']]" position="after">

                <field name="custom_invoice_type"/>

            </xpath>

            <xpath expr="//group[@id='header_right_group']/label[@for='invoice_date'][1]" position="before">
              <group invisible="not tog_button">
                  <label for="custom_street2" string="Address"/>
<!--                  <label for="custom" string="Address"/>-->
                <div class="o_address_format">
                    <field name="custom_street" placeholder="Street" class="o_address_street"/>

                    <field name="custom_street2" placeholder="Street 2" class="o_address_street"/>
                    <div class="o_row">
                       <field name="custom_city" placeholder="City" class="o_address_city"/>

                       <field name="custom_state_id" class="o_address_state" options="{'no_open': True, 'no_create': True}"/>

                       <field name="custom_zip" placeholder="ZIP" class="o_address_zip"/>
                    </div>

                    <field name="custom_country_id" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                </div>
              </group>
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                 <label for="tog_button" string="Address"/>
                 <field name="tog_button" widget="boolean_toggle" nolabel="1"/>
             </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="after">

                <field name="custom_size"/>

            </xpath>


        </field>

    </record>

</odoo>
<!-- ORM Methods & Decorators-->