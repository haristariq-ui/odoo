<odoo>
    <record id="view_vendor_data_wizard_form" model="ir.ui.view">
        <field name="name">vendor.data.wizard.form</field>
        <field name="model">vendor.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Data">
                <group>
                    <field name="product_id"/>
                    <field name="default_code"/>
                    <field name="categ_id"/>
                    <field name="list_price"/>
                </group>
                <group string="Vendor Lines">
                    <field name="vendor_line_ids">
                        <list>
                            <field name="vendor_id" width="250"/>
                            <field name="price" width="180"/>
                            <field name="min_qty" width="180"/>
                            <field name="delay" width="180"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Get Data" name="action_get_data" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>