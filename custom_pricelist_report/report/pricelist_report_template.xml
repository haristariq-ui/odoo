<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="pricelist_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2>
                            <span t-field="doc.name"/>
                        </h2>
                        <p>
                            <strong>Currency:</strong>
                            <span t-field="doc.currency_id"/>
                        </p>
                        <br/>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th style="width:20%">
                                        Product Code
                                    </th>
                                    <th style="width:55%">
                                        Product Description
                                    </th>
                                    <th class="text-end" style="width:25%">
                                        Unit Price
                                        (<span t-esc="doc.currency_id.name"/>)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.item_ids" t-as="line">
                                    <t t-if="line.product_tmpl_id">
                                        <tr>
                                            <td>
                                                <span t-esc="line.product_tmpl_id.product_variant_id.default_code or ''"/>
                                            </td>
                                            <td>
                                                <span t-field="line.product_tmpl_id.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="'%.2f' % line.fixed_price"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>