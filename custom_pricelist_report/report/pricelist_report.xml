<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_report_pricelist_pdf" model="ir.actions.report">
        <field name="name">PDF</field>
        <field name="model">product.pricelist</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_pricelist_report.pricelist_report_template</field>
        <field name="report_file">custom_pricelist_report.pricelist_report_template</field>
        <field name="binding_model_id" ref="product.model_product_pricelist"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_export_pricelist_excel_print" model="ir.actions.server">
        <field name="name">Excel</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="binding_model_id" ref="product.model_product_pricelist"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">action = record.action_export_pricelist_excel()</field>
    </record>
</odoo>