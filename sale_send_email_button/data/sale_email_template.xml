<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="email_template_custom_sale_order_confirmation" model="mail.template">
            <field name="name">Custom Sales Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">
                {{ object.company_id.name }} - Order confirmation (Ref {{ object.name }})
            </field>
            <field name="email_from">
                {{ object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted }}
            </field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="body_html" type="html">
                <div style="
                    margin: 0;
                    padding: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    color: #333333;
                ">
                    <p>
                        Hello
                        <t t-out="object.partner_id.name or ''"/>
                        ,
                    </p>
                    <p>
                        Your order
                        <strong>
                            <t t-out="object.name or ''"/>
                        </strong>
                        amounting to
                        <strong>
                            <t t-out="format_amount(object.amount_total, object.currency_id) or ''"/>
                        </strong>
                        has been confirmed.
                    </p>
                    <p>
                        Thank you for your trust!
                    </p>
                    <p>
                        Do not hesitate to contact us if you have any questions.
                    </p>
                    <br/>
                    <p>
                        Best regards,
                        <br/>
                        <strong>
                            <t t-out="object.user_id.name or user.name or ''"/>
                        </strong>
                        <br/>
                        <t t-out="object.company_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
</odoo>
